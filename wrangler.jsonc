// Static site for chao600.com: serves the `site/` folder, no Worker code, no logs.
// Deploy: npx wrangler deploy
{
  "name": "chao600",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "site"
  },
  "routes": [
    { "pattern": "chao600.com", "custom_domain": true },
    { "pattern": "www.chao600.com", "custom_domain": true }
  ]
}
