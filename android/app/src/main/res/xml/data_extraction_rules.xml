<?xml version="1.0" encoding="utf-8"?>
<!-- The blocked-call log never leaves the phone: not in cloud backups, not in device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
